{
  "Urls": "http://localhost:5000",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=MetroTechDB;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Cors": {
    "Origins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "Ollama": {
    "BaseUrl": "http://localhost:11434",
    "ChatModel": "PUT_YOUR_MODEL_NAME_FROM_OLLAMA_LIST",
    "EmbedModel": "bge-m3",
    "KeepAlive": "30m",
    "NumCtx": 4096,
    "TimeoutSeconds": 300
  },
  "Rag": {
    "ChunkSize": 800,
    "ChunkOverlap": 120,
    "EmbedBatchSize": 16,
    "TopK": 4,
    "MinScore": 0.25,
    "MaxImageBase64Length": 8000000
  }
}